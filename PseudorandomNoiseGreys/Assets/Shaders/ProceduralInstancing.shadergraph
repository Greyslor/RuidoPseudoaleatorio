{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "2e73e48a023c48e599bc605d874cb46b",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "ShaderGraphFunction (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -421.0,
            "y": 171.0,
            "width": 278.0,
            "height": 118.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "5fb962888cbd473a926993989551438f"
        },
        {
            "m_Id": "9ba9e00105f3461a8763314229c8df94"
        },
        {
            "m_Id": "018dee8f7de1477d840ccdc485dcfc91"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "ShaderGraphFunction",
    "m_FunctionSource": "95b1594c6b5ebff4abd65340f95dbd6b",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 GetHashColor()\r\n{\r\n    #if defined(UNITY_PROCEDURAL_INSTANCING_ENABLED)\r\n    uint hash = _Hashes[unity_InstanceID];\r\n    return _Config.y * _Config.y * hash;\r\n    #else\r\n    return 1.0;\r\n    #endif\r\n}\r\n\r\nvoid ShaderGraphFunction_float(float3 In, out float3 Out, out float3 Color)\r\n{\r\n    Out = In;\r\n    Color = GetHashColor();\r\n}\r\n\r\nvoid ShaderGraphFunction_half(half3 In, out half3 Out, out half3 Color)\r\n{\r\n    Out = In;\r\n    Color = GetHashColor();\r\n}"
}

